# CASS configuration. Copy to .env and fill in. Only EXPO_PUBLIC_* values are
# bundled into the app; they are public by design. NEVER put the Supabase
# secret/service-role key, database password or OpenRouteService key here.

# Supabase -> Project Settings -> API (Project URL and Publishable key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Map style JSON URL from your tile provider (e.g. MapTiler style URL incl. its public key)
EXPO_PUBLIC_MAP_STYLE_URL=

# Build-time (not bundled): EAS project id for push notifications (from `npx eas-cli init`)
EAS_PROJECT_ID=
# Optional overrides
# APP_NAME=CASS
# APP_ID=app.cass.mobile
# GOOGLE_SERVICES_FILE=./google-services.json
